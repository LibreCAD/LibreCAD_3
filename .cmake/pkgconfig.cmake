include(GNUInstallDirs)
include(CMakePackageConfigHelpers)

set(LIB_DIR "${CMAKE_INSTALL_LIBDIR}")
set(BIN_DIR "${CMAKE_INSTALL_BINDIR}")
set(INC_DIR "${CMAKE_INSTALL_INCLUDEDIR}/${PROJECT_ALIAS}")
set(CONF_DIR "${CMAKE_INSTALL_LIBDIR}/cmake/${PROJECT_ALIAS}")
set(CONF_FILE "${CMAKE_CURRENT_BINARY_DIR}/${PROJECT_ALIAS}Config.cmake")
set(CONF_FILE_IN "${CMAKE_CURRENT_LIST_DIR}/_Config.cmake.in")

get_property(LC_COLLECT_LIBS GLOBAL PROPERTY LC_COLLECT_LIBS)
get_property(LC_COLLECT_INCDIRS GLOBAL PROPERTY LC_COLLECT_INCDIRS)

configure_package_config_file(
  ${CONF_FILE_IN} ${CONF_FILE}
  INSTALL_DESTINATION "${CONF_DIR}"
  INSTALL_PREFIX "${CMAKE_INSTALL_PREFIX}"
  PATH_VARS INC_DIR LIB_DIR BIN_DIR)

# add_library(${PROJECT_ALIAS} SHARED) install( TARGETS ${PROJECT_ALIAS} RUNTIME
# DESTINATION "${CMAKE_INSTALL_BINDIR}" LIBRARY DESTINATION
# "${CMAKE_INSTALL_LIBDIR}" ARCHIVE DESTINATION "${CMAKE_INSTALL_LIBDIR}")

install(FILES "${CONF_FILE}" DESTINATION "${CONF_DIR}")
