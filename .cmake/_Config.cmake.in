@PACKAGE_INIT@

include(CMakeFindDependencyMacro)
set_and_check(@PROJECT_ALIAS@_INC_DIR @PACKAGE_INC_DIR@)
set_and_check(@PROJECT_ALIAS@_LIB_DIR @PACKAGE_LIB_DIR@)
set_and_check(@PROJECT_ALIAS@_BIN_DIR @PACKAGE_BIN_DIR@)
set(@PROJECT_ALIAS@_LIBS "@LC_COLLECT_LIBS@")
set(@PROJECT_ALIAS@_INC_DIRS "@LC_COLLECT_INCDIRS@")
set(_NAME_ @PROJECT_ALIAS@)

find_dependency(PkgConfig)
find_dependency(Eigen3)

get_target_property(EIGEN_INC_DIRS Eigen3::Eigen INTERFACE_INCLUDE_DIRECTORIES)
include_directories(SYSTEM ${EIGEN_INC_DIRS} ${${_NAME_}_INC_DIRS})
